local COLOR_FOV_BASE = Color3.fromRGB(255, 255, 255)
local COLOR_FOV_LOCKED = Color3.fromRGB(0, 255, 120)

local fovO = D("Circle", { Thickness = 3, Color = Color3.new(0, 0, 0), Transparency = 0.5, NumSides = 64, Filled = false })
local fovC = D("Circle", { Thickness = 1.5, Transparency = 0.9, NumSides = 64, Filled = false, Color = COLOR_FOV_BASE })
local silentTargetPart = nil

local rcParams = RaycastParams.new()
pcall(function() rcParams.FilterType = Enum.RaycastFilterType.Exclude end)

local function isVisible(char, pos, cam)
    if A.wallbang then return true end
    rcParams.FilterDescendantsInstances = { LP.Character, cam }
    local origin = cam.CFrame.Position
    local r = workspace:Raycast(origin, pos - origin, rcParams)
    return (not r) or r.Instance:IsDescendantOf(char)
end

local function getSilentTarget()
    if not A.enabled then return nil end
    local cam = workspace.CurrentCamera
    local center = cam.ViewportSize / 2
    local myTeam = LP:GetAttribute("Team")
    local camPos = cam.CFrame.Position
    local bestPart = nil
    local bestDist = A.fov

    local charsFolder = workspace:FindFirstChild("Characters")
    if not charsFolder then return nil end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and (myTeam == nil or plr:GetAttribute("Team") ~= myTeam) then
            local char = charsFolder:FindFirstChild(plr.Name)
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if char and root and char:GetAttribute("Dead") ~= true then
                local hp = char:GetAttribute("Health")
                if hp == nil or hp > 0 then
                    if (root.Position - camPos).Magnitude <= A.maxDist then
                        local partName = (A.part == "Nearest") and "Head" or A.part
                        local targetP = char:FindFirstChild(partName) or char:FindFirstChild("Head")
                        if targetP then
                            local v = cam:WorldToViewportPoint(targetP.Position)
                            if v.Z > 0 then
                                local d = (Vector2.new(v.X, v.Y) - center).Magnitude
                                if d <= bestDist then
                                    if not A.visibleCheck or isVisible(char, targetP.Position, cam) then
                                        bestDist = d
                                        bestPart = targetP
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return bestPart
end

local function silentAimFrame()
    local cam = workspace.CurrentCamera
    local center = cam.ViewportSize / 2
    local showFov = A.enabled and A.fovCircle
    fovO.Visible, fovC.Visible = showFov, showFov
    if showFov then
        fovO.Position, fovC.Position = center, center
        fovO.Radius, fovC.Radius = A.fov, A.fov
        fovC.Color = silentTargetPart and COLOR_FOV_LOCKED or COLOR_FOV_BASE
    end
    silentTargetPart = getSilentTarget()
end

-- ===================== WALLBANG & SILENT HOOKS =====================
local BulletModule = safeRequire(RS.Components.Weapon.Classes.Bullet)
local GetRayIgnore = safeRequire(RS.Components.Common.GetRayIgnore)
local Raycast = safeRequire(RS.Shared.Raycast)

if BulletModule and BulletModule._performRaycast then
    if not _G.__originalPerformRaycast then
        _G.__originalPerformRaycast = BulletModule._performRaycast
    end

    BulletModule._performRaycast = function(self, spread)
        if A.enabled and silentTargetPart and silentTargetPart.Parent and silentTargetPart:IsDescendantOf(workspace) then
            local char = silentTargetPart.Parent
            if not (char:GetAttribute("Dead") == true) then
                local ok, result = pcall(function()
                    local ignoreList = GetRayIgnore and GetRayIgnore() or {LP.Character, workspace.CurrentCamera}
                    local cam = workspace.CurrentCamera
                    local vpCenter = cam.ViewportSize * 0.5
                    local vpRay = cam:ViewportPointToRay(vpCenter.X, vpCenter.Y)
                    local Origin = vpRay.Origin
                    local targetPos = silentTargetPart.Position
                    local LookVector = (targetPos - Origin).Unit
                    local totalDistance = (targetPos - Origin).Magnitude
                    local range = math.max((self.Properties and self.Properties.Range) or 500, totalDistance + 50)
                    local penetration = A.wallbang and 9999 or ((self.Properties and self.Properties.Penetration) or 0)

                    local hitData = { Distance = totalDistance, Origin = Origin, Direction = LookVector, Hits = {} }
                    if Raycast and Raycast.cast then
                        local hitInfo = Raycast.cast(Origin, LookVector * range, nil, ignoreList)
                        if hitInfo and hitInfo.instance then
                            local hitPos = hitInfo.position
                            hitData.Distance = (hitPos - Origin).Magnitude
                            if Raycast.castThrough or A.wallbang then
                                local penetrationHits = (Raycast.castThrough and Raycast.castThrough(hitPos + LookVector * -0.001, LookVector * (penetration + 0.001), penetration, ignoreList)) or {}
                                for i = 1, #penetrationHits do
                                    local pHit = penetrationHits[i]
                                    if pHit.instance and pHit.material then
                                        table.insert(hitData.Hits, {
                                            Position = pHit.position,
                                            Instance = pHit.instance,
                                            Material = (pHit.material and pHit.material.Name) or tostring(pHit.material),
                                            Normal = pHit.normal or Vector3.new(0, 0, 0),
                                            Exit = (i % 2 == 0)
                                        })
                                    end
                                end
                            end
                        end
                    end
                    return hitData
                end)
                if ok and result then return result end
            end
        end
        return _G.__originalPerformRaycast(self, spread)
    end
end

