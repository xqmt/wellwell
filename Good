local function forceUpdateActiveWeapons()
    pcall(function()
        local char = LP.Character
        if not char then return end
        for _, obj in ipairs(char:GetChildren()) do
            if obj:IsA("Model") and obj.Name ~= "HumanoidRootPart" then
                -- Force viewmodel recreation/update if available
                local vmComp = obj:FindFirstChildOfClass("Model")
                if vmComp then
                    for _, child in ipairs(vmComp:GetDescendants()) do
                        if child:IsA("MeshPart") or child:IsA("BasePart") then
                            -- Touch transparency or trigger property updates to refresh render
                            child.Transparency = child.Transparency
                        end
                    end
                end
            end
        end
    end)
end

