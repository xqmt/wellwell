local function toggle(parent, text, key, w, onChange, tbl)
    local CFG_TARGET = tbl or CFG
    local row = Instance.new("TextButton")
    row.Size = UDim2.new(0, w or 120, 0, 26)
    row.BackgroundColor3 = T.card
    row.BackgroundTransparency = 0
    row.Text = ""
    row.AutoButtonColor = false
    row.Parent = parent
    corner(row, 5)
    local rowStroke = stroke(row, T.stroke, 1, 0.7)

    local l = label(row, text, 10) 
    l.Size = UDim2.new(1, -36, 1, 0) 
    l.Position = UDim2.new(0, 6, 0, 0)
    
    local sw = Instance.new("Frame") 
    sw.Size = UDim2.new(0, 24, 0, 14) 
    sw.Position = UDim2.new(1, -28, 0.5, -7) 
    sw.BorderSizePixel = 0 
    sw.Parent = row 
    corner(sw, 7)
    
    local swGrad = applyGradient3Color(sw)
    local kn = Instance.new("Frame") 
    kn.Size = UDim2.new(0, 10, 0, 10) 
    kn.BackgroundColor3 = Color3.new(1, 1, 1) 
    kn.BorderSizePixel = 0 
    kn.Parent = sw 
    corner(kn, 5)

    local function refresh(anim)
        local on = CFG_TARGET[key] and true or false
        local p = { BackgroundColor3 = on and Color3.new(1, 1, 1) or T.off }
        swGrad.Enabled = on
        local kp = { Position = on and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5) }
        if anim then tween(sw, p) tween(kn, kp) else sw.BackgroundColor3 = p.BackgroundColor3 kn.Position = kp.Position end
        rowStroke.Color = on and T.accentBright or T.stroke
        rowStroke.Transparency = on and 0.2 or 0.7
    end
    refresh(false)

    row.MouseButton1Click:Connect(function()
        CFG_TARGET[key] = not CFG_TARGET[key]
        refresh(true)
        saveCfg()
        if onChange then onChange(CFG_TARGET[key]) end
    end)
    return row
end

local function buttonToggle(parent, text, tbl, key, opts, w)
    local row = Instance.new("TextButton")
    row.Size = UDim2.new(0, w or 140, 0, 26)
    row.BackgroundColor3 = T.card
