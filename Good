                    if (root.Position - camPos).Magnitude <= A.maxDist then
                        local targetP = getBestPartForChar(char, cam, center)
                        if targetP then
                            local v = cam:WorldToViewportPoint(targetP.Position)
                            if v.Z > 0 then
                                local d = (Vector2.new(v.X, v.Y) - center).Magnitude
                                if d <= bestDist then
                                    if not A.visibleCheck or isVisible(char, targetP.Position, cam) then
                                        bestDist = d
                                        bestPart = targetP
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return bestPart
end

