    for k, f in pairs(orig) do
        if k == "ViewmodelNew" then if type(ViewmodelMod) == "table" then ViewmodelMod.new = f end
        else SkinsLib[k] = f end
    end
    if _G.__originalPerformRaycast and BulletModule then
        BulletModule._performRaycast = _G.__originalPerformRaycast
        _G.__originalPerformRaycast = nil
    end
    pcall(function() inputConn:Disconnect() end)
    pcall(function() espConn:Disconnect() end)
    for _, s in pairs(pool) do removeSet(s) end
    pool = {}
    pcall(fovO.Remove, fovO)
    pcall(fovC.Remove, fovC)
    pcall(function() gui:Destroy() end)
