local function resolve(weapon, skin)
    if not CFG.enabled or type(weapon) ~= "string" then return weapon, skin end
    local w = weapon
    if CFG.knifeModel and isKnife(weapon) and CFG.knifeModel ~= weapon and weaponExists(CFG.knifeModel) then w = CFG.knifeModel
    elseif CFG.gloveModel and isGlove(weapon) and CFG.gloveModel ~= weapon and weaponExists(CFG.gloveModel) then w = CFG.gloveModel end
    local want = CFG.skins[w]
    if want and skinExists(w, want) then return w, want end
    if w ~= weapon then return w, fallbackSkin(w, skin) end
    return weapon, skin
end

