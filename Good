local function isVisible(char, pos, cam)
    if A.wallbang then return true end
    rcParams.FilterDescendantsInstances = { LP.Character, cam }
    local origin = cam.CFrame.Position
    local r = workspace:Raycast(origin, pos - origin, rcParams)
    return (not r) or r.Instance:IsDescendantOf(char)
end

local function getBestPartForChar(char, cam, center)
    if A.part == "Closest" then
        local headP = char:FindFirstChild("Head")
        local torsoP = char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
        local bestP, bestScreenDist = nil, math.huge
        
        for _, p in ipairs({ headP, torsoP }) do
            if p then
                local v = cam:WorldToViewportPoint(p.Position)
                if v.Z > 0 then
                    local d = (Vector2.new(v.X, v.Y) - center).Magnitude
                    if d < bestScreenDist then
                        bestScreenDist = d
                        bestP = p
                    end
                end
            end
        end
        return bestP
    else
        return char:FindFirstChild("Head")
    end
end

