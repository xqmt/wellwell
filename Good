local function cloneTable(t)
    if type(t) ~= 'table' then return t end
    local copy = {}
    for k, v in pairs(t) do
        if type(v) == 'table' then
            copy[k] = cloneTable(v)
        else
            copy[k] = v
        end
    end
    return copy
end

local function patchDatabaseConfig(cfg, name)
    if not cfg or type(cfg) ~= 'table' then return end
    if isreadonly(cfg) then setreadonly(cfg, false) end

    local origCfg = WeaponEngine._originalConfigs[name] or {}

    if G.firerate and G.firerateValue then
        cfg.FireRate = G.firerateValue
    elseif origCfg.FireRate ~= nil then
        cfg.FireRate = origCfg.FireRate
    end

    if G.autoFire then
        cfg.Automatic = true
    elseif origCfg.Automatic ~= nil then
        cfg.Automatic = origCfg.Automatic
    end

    if type(cfg.FireModes) == 'table' then
        if isreadonly(cfg.FireModes) then setreadonly(cfg.FireModes, false) end
        if type(cfg.FireModes.Primary) == 'table' then
            if isreadonly(cfg.FireModes.Primary) then setreadonly(cfg.FireModes.Primary, false) end
            if G.firerate and G.firerateValue then
                cfg.FireModes.Primary.FireRate = G.firerateValue
            elseif origCfg.FireModes and origCfg.FireModes.Primary and origCfg.FireModes.Primary.FireRate ~= nil then
                cfg.FireModes.Primary.FireRate = origCfg.FireModes.Primary.FireRate
            end
            if G.autoFire then
                cfg.FireModes.Primary.HoldRepeat = true
            elseif origCfg.FireModes and origCfg.FireModes.Primary and origCfg.FireModes.Primary.HoldRepeat ~= nil then
                cfg.FireModes.Primary.HoldRepeat = origCfg.FireModes.Primary.HoldRepeat
            end
            table.freeze(cfg.FireModes.Primary)
        end
        if type(cfg.FireModes.Secondary) == 'table' then
            if isreadonly(cfg.FireModes.Secondary) then setreadonly(cfg.FireModes.Secondary, false) end
            if G.firerate and G.firerateValue then
                cfg.FireModes.Secondary.FireRate = G.firerateValue
            elseif origCfg.FireModes and origCfg.FireModes.Secondary and origCfg.FireModes.Secondary.FireRate ~= nil then
                cfg.FireModes.Secondary.FireRate = origCfg.FireModes.Secondary.FireRate
            end
            if G.autoFire then
                cfg.FireModes.Secondary.HoldRepeat = true
            elseif origCfg.FireModes and origCfg.FireModes.Secondary and origCfg.FireModes.Secondary.HoldRepeat ~= nil then
                cfg.FireModes.Secondary.HoldRepeat = origCfg.FireModes.Secondary.HoldRepeat
            end
            table.freeze(cfg.FireModes.Secondary)
        end
        table.freeze(cfg.FireModes)
    end

    table.freeze(cfg)
end

