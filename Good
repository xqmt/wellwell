local function buildWeapons()
    for _, c in ipairs(wepList:GetChildren()) do 
        if c:IsA("TextButton") then c:Destroy() end 
    end
    wepButtons = {}
    local q = search.Text:lower()
    for i, w in ipairs(allWeapons) do
        local cat = classOf(w)
        if (currentCat == "All" or cat == currentCat) and (q == "" or w:lower():find(q, 1, true)) then
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1, 0, 0, 26) 
            b.LayoutOrder = i 
            b.Text = "" 
            b.AutoButtonColor = false
            b.BackgroundColor3 = (selectedWeapon == w) and T.accentDim or T.card
            b.BackgroundTransparency = 0
            b.Parent = wepList
            corner(b, 5)
            
            local wStroke = stroke(b, (selectedWeapon == w) and Color3.fromRGB(255, 255, 255) or T.stroke, 1, (selectedWeapon == w) and 0.2 or 0.7)
            if selectedWeapon == w then applyGradient3Color(wStroke) end

            local p = props(w)
            if p and (p.Icon or p.ReverseIcon) then 
                iconImage(b, p.Icon or p.ReverseIcon, UDim2.new(0, 30, 0, 18)).Position = UDim2.new(0, 4, 0.5, -9) 
            end

            local l = label(b, w, 10, T.text, MAIN_FONT)
            l.Size = UDim2.new(1, -40, 1, 0) 
            l.Position = UDim2.new(0, 36, 0, 0)

            if CFG.skins[w] then
                local m = Instance.new("Frame") 
                m.Size = UDim2.new(0, 5, 0, 5) 
                m.Position = UDim2.new(1, -8, 0.5, -2) 
                m.BackgroundColor3 = T.green 
                m.BorderSizePixel = 0 
                m.Parent = b 
                corner(m, 3)
            end

            b.MouseButton1Click:Connect(function() selectWeapon(w) end)
            wepButtons[w] = b
        end
    end
end

